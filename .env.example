# Copy to .env and set nonempty local values. Do not commit .env.
POSTGRES_PASSWORD=
# Set JWT_SECRET to at least 32 UTF-8 bytes in the local .env file.
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
POSTGRES_HOST_PORT=5432
API_HOST_PORT=5080
FRONTEND_HOST_PORT=3000
# Backend calls the real ai-service:8000 inside Compose, including CI.
AI_TIMEOUT_SECONDS=15
AI_HOST_PORT=8000
AGRIVISION_DATASET_VERSION=v1.4
AGRIVISION_MODEL_VERSION=convnext-tiny-v1.4
