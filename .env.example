# Copy to .env and set nonempty local values. Do not commit .env.
POSTGRES_PASSWORD=
# Set JWT_SECRET to at least 32 UTF-8 bytes in the local .env file.
JWT_SECRET=
# R2 S3 credentials stay on the backend. Use newly rotated keys, never commit .env.
R2_SERVICE_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=agrivision-images-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
POSTGRES_HOST_PORT=5432
API_HOST_PORT=5080
FRONTEND_HOST_PORT=3000
# Backend calls the real ai-service:8000 inside Compose, including CI.
AI_TIMEOUT_SECONDS=15
AI_HOST_PORT=8000
