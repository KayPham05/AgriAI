# Copy to .env and set nonempty local values. Do not commit .env.
POSTGRES_PASSWORD=
# Set JWT_SECRET to at least 32 UTF-8 bytes in the local .env file.
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
POSTGRES_HOST_PORT=5432
API_HOST_PORT=5080
FRONTEND_HOST_PORT=3000
# Real AI service used by the base Compose stack; CI overrides it with a stub.
AI_SERVICE_URL=http://host.docker.internal:8000
AI_TIMEOUT_SECONDS=15
