title Activity — UC-05 prediction phía API
|Backend|
start
:POST /api/predictions\nUserId từ JWT nếu có;
if (File không rỗng / đuôi hợp lệ?) then (yes)
 :Buffer ảnh;
else (no)
 :400;
 stop
endif
|Image storage|
:UploadImageAsync;
if (Cloudinary cấu hình và upload thành công?) then (yes)
 :Trả public ID / secure URL;
else (no)
 :Ghi file local / trả local ID và URL;
endif
|Backend|
:Gọi predictor với stream độc lập;
|HTTP AI client|
:POST /predict multipart file;
if (HTTP thất bại hoặc timeout?) then (yes)
 :AiServiceException 503;
 |Backend|
 :Trả 503 / chưa lưu prediction;
 note right: Ảnh đã lưu; chưa có cleanup.
 stop
else (no)
 |HTTP AI client|
 if (JSON / contract hợp lệ?) then (yes)
  :Trả AiPredictionResult;
 else (no)
  :AiServiceException 502;
  |Backend|
  :Trả 502 / chưa lưu prediction;
  stop
 endif
endif
|Backend|
:Mapping ClassIndex rồi ClassName;
if (Không tìm thấy mapping chính?) then (yes)
 :Lấy bản ghi đầu tiên active;
 if (Danh mục trống?) then (yes)
  :InvalidOperationException / 400;
  stop
 endif
endif
:Tạo Prediction / details top-k\nitem không khớp dùng lớp chính;
|Database|
:IPredictionRepository.AddAsync\nSaveChangesAsync;
if (Ghi DB thành công?) then (yes)
 |Backend|
 :201 PredictionResultDto + Location;
else (no)
 |Backend|
 :Exception qua middleware\nDB update error thường 500;
 note right: Không có bước tự dọn ảnh.
endif
stop
@enduml
