@startuml
skinparam backgroundColor #f5f5f5
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #2d3142
skinparam ArrowColor #4f5d75
skinparam shadowing false
skinparam roundcorner 6
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam NoteBackgroundColor #ececec
skinparam NoteBorderColor #bfc0c0
skinparam sequenceParticipantBackgroundColor #ffffff
skinparam sequenceParticipantBorderColor #2d3142
skinparam activityBackgroundColor #ffffff
skinparam activityBorderColor #2d3142
skinparam stateBackgroundColor #ffffff
skinparam stateBorderColor #2d3142
skinparam classBackgroundColor #ffffff
skinparam classBorderColor #2d3142
skinparam usecaseBackgroundColor #ffffff
skinparam usecaseBorderColor #2d3142
skinparam rectangleBackgroundColor #ffffff
skinparam rectangleBorderColor #2d3142
skinparam circleBackgroundColor #ffffff
skinparam circleBorderColor #2d3142
title Use Case — hiện trạng, 10 mục tiêu nghiệp vụ
left to right direction
skinparam nodesep 32
skinparam ranksep 45
actor "Khách" as Guest
actor "Người dùng\nđã đăng nhập" as User
actor Admin
actor "Người vận hành" as Ops
actor "Dịch vụ HTTP AI" as AI
actor Cloudinary as Cloud
User --|> Guest
Admin --|> User
rectangle "AgriVision (web + API + DB + local storage)" {
  usecase "UC-01\nĐăng ký" as U1
  usecase "UC-02\nĐăng nhập" as U2
  usecase "UC-03\nHồ sơ / khôi phục phiên" as U3
  usecase "UC-04\nĐăng xuất browser" as U4
  usecase "UC-05\nPhân loại một ảnh" as U5 #FBECE5
  usecase "UC-06\nXem kết quả / lịch sử" as U6
  usecase "UC-07\nXóa kết quả" as U7
  usecase "UC-08\nTra cứu cây/bệnh" as U8
  usecase "UC-09\nQuản lý danh mục" as U9
  usecase "UC-10\nKiểm tra dịch vụ" as U10
}
Guest -- U1
Guest -- U2
Guest -- U5 : API trực tiếp
Guest -- U6 : chỉ chi tiết API
Guest -- U8 : API trực tiếp
User -- U3
User -- U4
User -- U5 : web sau đăng nhập
User -- U6 : lịch sử riêng / web
User -- U7
User -- U8 : web sau đăng nhập
Admin -- U9 : tạo / sửa / xóa
Ops -- U10
U5 -- AI
U5 -- Cloud
U7 -- Cloud
U10 -- AI
legend bottom
HIỆN TRẠNG: web chính mở sau login/restore; khách gọi API public trực tiếp.
UC-03: đọc/restore và sửa UI chỉ state; UC-06: lịch sử riêng cần JWT.
UC-07: owner/Admin; UC-09: Admin qua API, chưa có UI quản trị.
Các bước kiểm ảnh / storage / AI / DB nằm trong Activity và Sequence.
Cloudinary tùy cấu hình; HTTP AI client không chứng minh inference thật.
endlegend
@enduml
