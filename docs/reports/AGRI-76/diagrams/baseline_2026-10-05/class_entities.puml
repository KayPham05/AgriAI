skinparam defaultFontSize 14
skinparam defaultFontColor #2d3142
skinparam ArrowColor #4f5d75
skinparam shadowing false
skinparam roundcorner 6
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam NoteBackgroundColor #ececec
skinparam NoteBorderColor #bfc0c0
skinparam sequenceParticipantBackgroundColor #ffffff
skinparam sequenceParticipantBorderColor #2d3142
skinparam activityBackgroundColor #ffffff
skinparam activityBorderColor #2d3142
skinparam stateBackgroundColor #ffffff
skinparam stateBorderColor #2d3142
skinparam classBackgroundColor #ffffff
skinparam classBorderColor #2d3142
skinparam usecaseBackgroundColor #ffffff
skinparam usecaseBorderColor #2d3142
skinparam rectangleBackgroundColor #ffffff
skinparam rectangleBorderColor #2d3142
skinparam circleBackgroundColor #ffffff
skinparam circleBorderColor #2d3142
title Class — Domain entities (property chọn lọc, navigation thật)
hide methods
class User {
 + Id: Guid
 + FullName: string
 + Email: string
 + PasswordHash: string
 + Role: string
 + CreatedAt: DateTime
 + UpdatedAt: DateTime?
 + Predictions: ICollection<Prediction>
}
class Plant {
 + Id: Guid
 + Name: string
 + VietnameseName: string?
 + ScientificName: string?
 + Description: string?
 + IsActive: bool
 + CreatedAt: DateTime
 + UpdatedAt: DateTime?
 + PlantDiseases: ICollection<PlantDisease>
}
class Disease {
 + Id: Guid
 + Name: string
 + VietnameseName: string?
 + Description: string?
 + Symptoms: string?
 + Treatment: string?
 + Prevention: string?
 + IsActive: bool
 + CreatedAt: DateTime
 + UpdatedAt: DateTime?
 + PlantDiseases: ICollection<PlantDisease>
}
class PlantDisease {
 + Id: Guid
 + PlantId: Guid
 + DiseaseId: Guid
 + ClassName: string
 + ClassIndex: int
 + IsActive: bool
 + Plant: Plant
 + Disease: Disease
 + Predictions: ICollection<Prediction>
 + PredictionDetails: ICollection<PredictionDetail>
}
class Prediction #FBECE5 {
 + Id: Guid
 + UserId: Guid?
 + ImagePath: string
 + ImagePublicId: string?
 + PredictedPlantDiseaseId: Guid
 + Confidence: double
 + CreatedAt: DateTime
 + User: User?
 + PredictedPlantDisease: PlantDisease
 + PredictionDetails: ICollection<PredictionDetail>
}
class PredictionDetail {
 + Id: Guid
 + PredictionId: Guid
 + PlantDiseaseId: Guid
 + Probability: double
 + Rank: int
 + Prediction: Prediction
 + PlantDisease: PlantDisease
}
User "0..1" -- "0..*" Prediction
Plant "1" -- "0..*" PlantDisease
Disease "1" -- "0..*" PlantDisease
PlantDisease "1" -- "0..*" Prediction
Prediction "1" -- "0..*" PredictionDetail
PlantDisease "1" -- "0..*" PredictionDetail
note bottom of Prediction
Auto-properties public; không liệt kê getter/setter.
Không có Status / model version.
Association navigation, không tự thêm diamond ownership.
end note
@enduml
