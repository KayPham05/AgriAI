@startuml
skinparam backgroundColor #f5f5f5
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #2d3142
skinparam ArrowColor #4f5d75
skinparam shadowing false
skinparam roundcorner 6
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam NoteBackgroundColor #ececec
skinparam NoteBorderColor #bfc0c0
skinparam sequenceParticipantBackgroundColor #ffffff
skinparam sequenceParticipantBorderColor #2d3142
skinparam activityBackgroundColor #ffffff
skinparam activityBorderColor #2d3142
skinparam stateBackgroundColor #ffffff
skinparam stateBorderColor #2d3142
skinparam classBackgroundColor #ffffff
skinparam classBorderColor #2d3142
skinparam usecaseBackgroundColor #ffffff
skinparam usecaseBorderColor #2d3142
skinparam rectangleBackgroundColor #ffffff
skinparam rectangleBorderColor #2d3142
skinparam circleBackgroundColor #ffffff
skinparam circleBorderColor #2d3142
title Sequence — UC-01 đăng ký / UC-02 đăng nhập
actor User
participant "LoginModal / authApi" as Web
participant AuthController as Controller
participant AuthService as Service
database "UserRepository / PostgreSQL" as DB
participant JwtTokenGenerator as JWT
User -> Web : submit credentials
alt register
 Web -> Controller : POST /api/auth/register
 Controller -> Service : RegisterAsync
 Service -> DB : ExistsByEmailAsync
 DB --> Service : exists
 alt email đã có
  Service --> Controller : InvalidOperationException
  Controller --> Web : middleware 400
 else email chưa có
  Service -> Service : BCrypt.HashPassword / User role User
  Service -> DB : AddAsync / SaveChanges
  DB --> Service : saved
  Service -> JWT : GenerateToken(user)
  JWT --> Service : signed JWT
  Service --> Controller : AuthResponse
  Controller --> Web : 200 token + UserDto
 end
else login
 Web -> Controller : POST /api/auth/login
 Controller -> Service : LoginAsync
 Service -> DB : GetByEmailAsync
 DB --> Service : user hoặc null
 Service -> Service : kiểm user / PasswordHash không NULL rồi BCrypt.Verify
 alt sai thông tin
  Service --> Controller : UnauthorizedAccessException
  Controller --> Web : middleware 401
 else đúng
  Service -> JWT : GenerateToken(user)
  JWT --> Service : signed JWT
  Service --> Controller : AuthResponse
  Controller --> Web : 200 token + UserDto
 end
end
Web -> Web : saveAuthSession nếu thành công
Web --> User : kết quả đăng nhập / lỗi
@enduml
