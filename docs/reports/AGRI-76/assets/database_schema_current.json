  "constraints": [
    {
      "table_name": "\"__EFMigrationsHistory\"",
      "name": "PK___EFMigrationsHistory",
      "definition": "PRIMARY KEY (\"MigrationId\")"
    },
    {
      "table_name": "diseases",
      "name": "PK_diseases",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "diseases",
      "name": "ck_diseases_condition_type",
      "definition": "CHECK (((condition_type)::text = ANY ((ARRAY['Unknown'::character varying, 'Healthy'::character varying, 'NutrientDeficiency'::character varying, 'Disease'::character varying])::text[])))"
    },
    {
      "table_name": "plant_diseases",
      "name": "FK_plant_diseases_diseases_disease_id",
      "definition": "FOREIGN KEY (disease_id) REFERENCES diseases(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "plant_diseases",
      "name": "FK_plant_diseases_plants_plant_id",
      "definition": "FOREIGN KEY (plant_id) REFERENCES plants(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "plant_diseases",
      "name": "PK_plant_diseases",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "plant_diseases",
      "name": "ck_plant_diseases_class_index",
      "definition": "CHECK ((class_index >= 0))"
    },
    {
      "table_name": "plants",
      "name": "PK_plants",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "prediction_details",
      "name": "FK_prediction_details_plant_diseases_plant_disease_id",
      "definition": "FOREIGN KEY (plant_disease_id) REFERENCES plant_diseases(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "prediction_details",
      "name": "FK_prediction_details_predictions_prediction_id",
      "definition": "FOREIGN KEY (prediction_id) REFERENCES predictions(id) ON DELETE CASCADE"
    },
    {
      "table_name": "prediction_details",
      "name": "PK_prediction_details",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "prediction_details",
      "name": "ck_prediction_details_rank",
      "definition": "CHECK ((rank > 0))"
    },
    {
      "table_name": "prediction_images",
      "name": "FK_prediction_images_predictions_prediction_id",
      "definition": "FOREIGN KEY (prediction_id) REFERENCES predictions(id) ON DELETE CASCADE"
    },
    {
      "table_name": "prediction_images",
      "name": "PK_prediction_images",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "prediction_images",
      "name": "ck_prediction_images_expiry",
      "definition": "CHECK ((expires_at > uploaded_at))"
    },
    {
      "table_name": "prediction_images",
      "name": "ck_prediction_images_position",
      "definition": "CHECK ((\"position\" >= 0))"
    },
    {
      "table_name": "predictions",
      "name": "FK_predictions_plant_diseases_predicted_plant_disease_id",
      "definition": "FOREIGN KEY (predicted_plant_disease_id) REFERENCES plant_diseases(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "predictions",
      "name": "FK_predictions_users_user_id",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL"
    },
    {
      "table_name": "predictions",
      "name": "PK_predictions",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "user_action_tokens",
      "name": "FK_user_action_tokens_users_user_id",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"
    },
    {
      "table_name": "user_action_tokens",
      "name": "PK_user_action_tokens",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "user_action_tokens",
      "name": "ck_user_action_tokens_expiry",
      "definition": "CHECK ((expires_at > created_at))"
    },
    {
      "table_name": "user_action_tokens",
      "name": "ck_user_action_tokens_hash",
      "definition": "CHECK (((token_hash)::text ~ '^[0-9a-f]{64}$'::text))"
    },
    {
      "table_name": "user_action_tokens",
      "name": "ck_user_action_tokens_purpose",
      "definition": "CHECK (((purpose)::text = ANY ((ARRAY['EmailVerification'::character varying, 'PasswordReset'::character varying])::text[])))"
    },
    {
      "table_name": "user_identities",
      "name": "FK_user_identities_users_user_id",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"
    },
    {
      "table_name": "user_identities",
      "name": "PK_user_identities",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "users",
      "name": "PK_users",
      "definition": "PRIMARY KEY (id)"
    }
  ],
